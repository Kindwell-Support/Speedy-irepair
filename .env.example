# Speedy iRepair — environment contract. Full docs: docs/ENV.md
# Copy to .env.local for local dev. NEVER commit real values. Every var is optional for local dev:
# with nothing set, the site runs entirely on fixtures (Sanity content + Shopify snapshot) and noindex.

# --- Site ---
# Canonical origin, no trailing slash. Staging: the Vercel preview URL. Production: https://speedyirepair.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "staging" (default, noindex everywhere) | "production" (indexable). Only the production env sets "production".
NEXT_PUBLIC_SITE_ENV=staging

# --- Sanity (public) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01

# --- Sanity (server-only secrets) ---
# Viewer token: draft mode / Presentation preview
SANITY_API_READ_TOKEN=
# Editor token: forms write `formSubmission` documents
SANITY_API_WRITE_TOKEN=
# Shared secret for /api/revalidate (Sanity webhook) and /api/draft-mode/enable
SANITY_REVALIDATE_SECRET=

# --- Shopify Storefront API (server-only) ---
# e.g. speedy-irepair.myshopify.com  (unset => fixture adapter + staging notice on Add to cart)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10

# --- Forms ---
# Notification webhook (receives JSON + x-speedy-signature HMAC-SHA256 header)
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
# Optional Cloudflare Turnstile (off by default)
FORMS_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Embeds ---
# Google Maps embed src (https://www.google.com/maps/embed?pb=...). Unset => map facade links to the Maps URL.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# --- Repair booking: GoHighLevel (server-only, never NEXT_PUBLIC_) ---
# /repair sends every lead to GHL when ALL of these are set; otherwise it falls back to the logging mock
# (lib/booking/mock-provider.ts) and leads are not saved. Stage IDs are from the "Repair Bookings" pipeline.
# Check field IDs and dropdown spellings against the live account: npx tsx --env-file=.env.local scripts/ghl-check.ts
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=
GHL_PIPELINE_ID=
GHL_STAGE_INTAKE_STARTED=
GHL_STAGE_NEW_LEAD=
GHL_STAGE_BOOKED=
