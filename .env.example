# Speedy iRepair — environment contract. Full docs: docs/ENV.md
# Copy to .env.local for local dev. NEVER commit real values. Every var is optional for local dev:
# with nothing set, the site runs entirely on fixtures (Sanity content + Shopify snapshot) and noindex.

# --- Site ---
# Canonical origin, no trailing slash. Staging: the Vercel preview URL. Production: https://speedyirepair.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "staging" (default, noindex everywhere) | "production" (indexable). Only the production env sets "production".
NEXT_PUBLIC_SITE_ENV=staging

# --- Sanity (public) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01

# --- Sanity (server-only secrets) ---
# Viewer token: draft mode / Presentation preview
SANITY_API_READ_TOKEN=
# Editor token: forms write `formSubmission` documents
SANITY_API_WRITE_TOKEN=
# Shared secret for /api/revalidate (Sanity webhook) and /api/draft-mode/enable
SANITY_REVALIDATE_SECRET=

# --- Shopify Storefront API (server-only) ---
# e.g. speedy-irepair.myshopify.com  (unset => fixture adapter + staging notice on Add to cart)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10

# --- Forms ---
# Notification webhook (receives JSON + x-speedy-signature HMAC-SHA256 header)
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
# Optional Cloudflare Turnstile (off by default)
FORMS_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Embeds ---
# Google Maps embed src (https://www.google.com/maps/embed?pb=...). Unset => map facade links to the Maps URL.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# --- Repair booking: GoHighLevel (server-only, never NEXT_PUBLIC_) ---
# /repair sends every lead to GHL when ALL of these are set; otherwise it falls back to the logging mock
# (lib/booking/mock-provider.ts) and leads are not saved. Stage IDs are from the "Repair Bookings" pipeline.
# Check field IDs and dropdown spellings against the live account: npx tsx --env-file=.env.local scripts/ghl-check.ts
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=
GHL_PIPELINE_ID=
GHL_STAGE_INTAKE_STARTED=
GHL_STAGE_NEW_LEAD=
GHL_STAGE_BOOKED=
# Optional. GHL user id(s) that new leads from /repair and /contact are assigned to, comma-separated; with
# several, leads are shared between them at random. A contact that already has an owner keeps it.
GHL_OWNER_USER_IDS=
#
# Also required once the vars above are set. If any of these is empty, every GHL call is refused and logged
# ("[ghl] GHL is misconfigured, missing env var(s): ..."), and the site stays up. scripts/ghl-check.ts prints all
# of them from the live account as ready-to-paste lines.
# "Quote Requested" stage of the Repair Bookings pipeline (/instant-quote)
GHL_STAGE_QUOTE_REQUESTED=
# Other pipelines and their first stage: General Inquiries (/contact), Device Buyback (/sell-your-device),
# Home Internet Leads (/home-internet)
GHL_INQUIRY_PIPELINE_ID=
GHL_INQUIRY_STAGE_NEW=
GHL_BUYBACK_PIPELINE_ID=
GHL_BUYBACK_STAGE_NEW=
GHL_INTERNET_PIPELINE_ID=
GHL_INTERNET_STAGE_NEW=
# Contact custom field IDs: GHL_FIELD_<fieldKey without "contact.", upper-cased>
GHL_FIELD_DEVICE_TYPE=
GHL_FIELD_BRAND=
GHL_FIELD_MODEL=
GHL_FIELD_ISSUE=
GHL_FIELD_PROBLEM_DETAILS=
GHL_FIELD_LOCATION=
GHL_FIELD_LEAD_SOURCE=
GHL_FIELD_LEAD_STATUS=
GHL_FIELD_SMS_CONSENT_AT=
GHL_FIELD_UTM_SOURCE=
GHL_FIELD_UTM_MEDIUM=
GHL_FIELD_UTM_CAMPAIGN=
GHL_FIELD_LANDING_PAGE=
GHL_FIELD_HOME_TYPE=
GHL_FIELD_INTERNET_NEED=
GHL_FIELD_INTERNET_TIMING=
GHL_FIELD_CURRENT_PROVIDER=
# The Location dropdown value exactly as GHL spells it, e.g. "Akron – W Market St" (en dash)
GHL_LOCATION_LABEL=
# IANA time zone for bookings and dates site-wide. Read at build time (next.config.ts), so redeploy after
# changing it. Unset or invalid => America/New_York.
GHL_TIMEZONE=

# ---------- Home internet availability data (script only, not needed on Vercel) ----------
# Used by scripts/internet-coverage.ts to download the FCC National Broadband Map files that build
# data/internet-coverage.json. Free account at broadbandmap.fcc.gov, then "Manage API Access" for the token.
FCC_BDC_USERNAME=
FCC_BDC_API_TOKEN=
